# Application mode. Demo is the safe default; live mode never shows demo placeholders.
DATA_MODE=demo

# Live storage provider: supabase (default) or sqlite for a local persistent file.
STORAGE_PROVIDER=supabase
SQLITE_DATABASE_PATH=.data/onchain-radar.sqlite
# Server-only Supabase service credentials. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for protected worker ingestion. Generate/store out of source control.
INGESTION_SECRET=

# Optional provider/server configuration.
GOPLUS_ACCESS_TOKEN=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SECURITY_TTL_SECONDS=900
MIN_LIQUIDITY_USD=5000

# Optional Origin allowlist for browser-originated ingestion requests.
APP_ORIGIN=
ALLOWED_INGEST_ORIGINS=

# Worker-only variables; set in the separate worker environment, not Netlify.
INGESTION_URL=https://your-site.example/api/ingest/social
AGENT_REACH_ADAPTER=node
AGENT_REACH_ADAPTER_ARGS_JSON=["worker/agent-reach-adapter.mjs"]
AGENT_REACH_ENV_ALLOWLIST=TWITTER_AUTH_TOKEN,TWITTER_CT0,TWITTER_CLI_BIN,AGENT_REACH_QUERY_CONFIG,AGENT_REACH_SEARCH_DATE,AGENT_REACH_MAX_SEARCHES,AGENT_REACH_RESULTS_PER_QUERY,AGENT_REACH_QUERY_DELAY_MS,AGENT_REACH_SEARCH_TIMEOUT_MS,AGENT_REACH_QUERY_OFFSET,HTTP_PROXY,HTTPS_PROXY
# X cookies: worker-only secrets. Fill locally, never commit actual values.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_CLI_BIN=
AGENT_REACH_QUERY_CONFIG=config/x-queries.json
# Optional YYYY-MM-DD. Omit/leave empty for today's date in Asia/Jakarta (WIB).
AGENT_REACH_SEARCH_DATE=
AGENT_REACH_MAX_SEARCHES=3
AGENT_REACH_RESULTS_PER_QUERY=10
AGENT_REACH_QUERY_DELAY_MS=500
AGENT_REACH_SEARCH_TIMEOUT_MS=25000
AGENT_REACH_TIMEOUT_MS=120000
# Scheduler interval in milliseconds; dashboard refresh is independently fixed at 10 minutes.
WORKER_INTERVAL_MS=600000
WORKER_LOCK_FILE=
